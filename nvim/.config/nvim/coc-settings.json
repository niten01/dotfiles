{
  "clangd.path": "~/.config/coc/extensions/coc-clangd-data/install/20.1.8/clangd_20.1.8/bin/clangd",
  "clangd.arguments": [
    "-j=10",
    "--background-index=true"
  ],
  "snippets.ultisnips.pythonPrompt": false,
  "python.analysis.typeCheckingMode": "off",
  "languageserver": {
    "ocaml-lsp": {
      "command": "opam",
      "args": [
        "config",
        "exec",
        "--",
        "ocamllsp"
      ],
      "filetypes": [
        "ocaml",
        "reason"
      ],
      "rootPatterns": [
        "dune-project", ".git", ".ocamlformat", "*.opam"
      ],
      "formatter": "ocamlformat"
    }
  },
  "htmldjango.djlint.indent": 2
}
